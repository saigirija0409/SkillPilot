# =============================================================================
# SkillPilot Backend Environment Variables (copy to backend/.env)
# NEVER commit backend/.env to Git.
# =============================================================================

# Server settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Comma-separated allowed CORS origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Configuration
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional for Phase 2+ server-side privileged operations (keep strictly secret)
SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key

# Google Gemini API Configuration
# Find this in Google AI Studio -> API keys
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Optional ML / Embeddings settings (used in Phase 3)
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_RESUME_SIZE_MB=5
